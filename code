public class MangaVolume{
    String tituloSerie;
    int numeroTomo;
    int cantidadPaginas;

    public MangaVolume(String tituloSerie, int numeroTomo, int cantidadPaginas) {
        this.tituloSerie = tituloSerie;
        this.numeroTomo = numeroTomo;
        this.cantidadPaginas = cantidadPaginas;
    }

    private boolean esTomoExtenso() {
        if (cantidadPaginas > 300) {
            return true;
        }else {
            return false;
        }
    }

    public boolean esEdicionEspecial() {
        return esTomoExtenso();
    }

    @Override
    public String toString() {
        return "Manga: " + tituloSerie + " - Tomo: " + numeroTomo + " - Páginas: " + cantidadPaginas + " - ¿Edición Especial?: " + esEdicionEspecial();
    }
}

// ----------------------------------------------------------------------------------------------------------------------------------------------------------------

public class Main {
    public static void main(String[] args){
        MangaVolume another = new MangaVolume("Another", 1, 677);
        System.out.println(another);

        MangaVolume adabana = new MangaVolume("Adabana", 2, 192);
        System.out.println(adabana);
    }
}
}
